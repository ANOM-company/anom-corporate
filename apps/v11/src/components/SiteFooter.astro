---
// フッター。会社の基本情報（現行サイトに掲載している内容だけ）とページ内のリンク。
interface Props {
  footer: {
    rows: { term: string; value: string }[];
    privacy: string;
    top: string;
    copyright: string;
    previewNote: string;
  };
  nav: { label: string; items: { label: string; href: string }[] };
  privacyUrl: string;
}

const { footer, nav, privacyUrl } = Astro.props;
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <p class="footer__logo latin">ANOM</p>
      <dl class="footer__info">
        {
          footer.rows.map((row) => (
            <div class="footer__row">
              <dt>{row.term}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <nav class="footer__nav" aria-label={`${nav.label}（フッター）`}>
      <ul>
        {
          nav.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={privacyUrl}>{footer.privacy}</a></li>
        <li><a href="#top">{footer.top}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer__bottom">
    <p>{footer.copyright}</p>
    <p>{footer.previewNote}</p>
  </div>
</footer>

<style>
  .footer {
    padding: 2.5rem 0 calc(var(--bar-h) + 2rem + env(safe-area-inset-bottom));
    background: var(--color-night);
    color: var(--color-on-night-soft);
    font-size: 0.8125rem;
  }

  .footer__inner {
    display: grid;
    gap: 2rem;
  }

  .footer__logo {
    color: var(--color-on-night);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .footer__info {
    margin-top: 1rem;
    display: grid;
    gap: 0.25rem;
  }

  .footer__row {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 0.75rem;

    dt {
      color: rgb(183 196 220 / 0.75);
    }

    dd {
      margin: 0;
      color: var(--color-on-night);
    }
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
  }

  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-on-night);
    text-decoration: none;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }

  .footer__bottom {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(238 243 252 / 0.15);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.75rem;
  }

  @media (min-width: 64rem) {
    .footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .footer__nav ul {
      max-width: 28rem;
      justify-content: flex-end;
    }
  }
</style>
