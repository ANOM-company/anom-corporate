---
// 画面下に固定する相談の入口。
// - ファーストビューの相談ボタンが見えなくなったら下から現れ、お問い合わせ欄が見えている間は隠れる
//   （src/scripts/bottom-bar.ts。隠れている間は inert でキーボード操作の対象から外す）
// - JavaScript 無効時は常に表示する
import Icon from './Icon.astro';

interface Props {
  bar: {
    label: string;
    title: string;
    body: string;
    primary: { label: string; href: string };
    secondary: { label: string; href: string };
  };
}

const { bar } = Astro.props;
---

<aside class="bar" aria-label={bar.label} data-bottom-bar>
  <div class="bar__inner">
    <p class="bar__text">
      <span class="bar__title">{bar.title}</span>
      <span class="bar__body">{bar.body}</span>
    </p>
    <div class="bar__actions">
      <a class="btn btn--primary bar__primary" href={bar.primary.href} data-cta="bar-primary">
        <Icon name="mail" class="bar__mail" />
        {bar.primary.label}
        <Icon name="arrow-right" class="btn__arrow" />
      </a>
      <a class="btn btn--night bar__secondary" href={bar.secondary.href} data-cta="bar-secondary">
        {bar.secondary.label}
        <Icon name="arrow-right" class="btn__arrow" />
      </a>
    </div>
  </div>
</aside>

<style>
  .bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, rgb(19 34 63 / 0.94), rgb(10 20 38 / 0.97));
    backdrop-filter: blur(12px);
    color: var(--color-on-night);
    box-shadow: 0 -12px 40px -20px rgb(10 20 38 / 0.6);
    transition:
      translate 480ms var(--ease-out),
      opacity 480ms var(--ease-out);
  }

  .bar:global(.is-hidden) {
    translate: 0 110%;
    opacity: 0;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100%, calc(var(--wrap) + 4rem));
    margin-inline: auto;
  }

  .bar__text {
    display: none;
  }

  .bar__actions {
    flex: 1;
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 0.5rem;
  }

  .bar__primary,
  .bar__secondary {
    min-height: 3rem;
    padding-inline: 0.75rem;
    gap: 0.4rem;
    font-size: 0.8125rem;
  }

  .bar :global(.bar__mail) {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }

  .bar :global(.btn__arrow) {
    display: none;
  }

  @media (min-width: 48rem) {
    .bar__actions {
      flex: none;
      display: flex;
      margin-left: auto;
    }

    .bar__primary,
    .bar__secondary {
      padding-inline: 1.5rem;
      font-size: 0.9375rem;
    }

    .bar :global(.btn__arrow) {
      display: block;
    }
  }

  @media (min-width: 64rem) {
    .bar__text {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      min-width: 0;
    }

    .bar__title {
      flex: none;
      padding-right: 1.25rem;
      border-right: 1px solid rgb(238 243 252 / 0.3);
      font-size: 1.0625rem;
      font-weight: 700;
    }

    .bar__body {
      color: var(--color-on-night-soft);
      font-size: 0.8125rem;
    }

    .bar__primary,
    .bar__secondary {
      min-height: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }
</style>
