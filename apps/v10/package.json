{
  "name": "anom-web-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ANOM Web Starter v1 — 静的サイト制作用の最小ひな形（Astro + TypeScript + Tailwind CSS）",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "build": "astro build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8788 --show-interactive-dev-session=false",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
