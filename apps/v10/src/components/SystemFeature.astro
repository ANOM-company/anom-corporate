---
/**
 * システム開発（#service-system）。主力2枠の下に置く、濃紺の独立した横長の枠。
 * - PC（1024px以上）は本文と図を左右に、狭い幅は 本文→相談例→図→相談ボタン の縦順
 *   本文・図・相談ボタンを同じグリッドに並べ、HTML の順（読み上げ・Tab の順）も 本文→図→相談ボタン にする。
 *   PC では相談ボタンを本文の下（左列の2段目）に置き、図は右列で2段にまたがせる
 * - 図の「入力する→整理する→確認する」は本文の順序付きリストで、外部連携や自動処理を装わない。
 *   640px未満は 小さな絵＋文言 の横並びの行にして、縦に長くなりすぎないようにする。
 *   絵だけが画面に入ったとき1回、順に少し現れる（data-reveal。文言は隠さない）
 */
import Button from './Button.astro';

type Props = {
  number: string;
  label: string;
  title: string;
  body: string;
  stepsLabel: string;
  steps: string[];
  examplesLabel: string;
  examplesNote: string;
  examples: string[];
  cta: { label: string; field: string };
  contactHref: string;
};

const { number, label, title, body, stepsLabel, steps, examplesLabel, examplesNote, examples, cta, contactHref } = Astro.props;
---

<article
  id="service-system"
  class="grid grid-cols-1 gap-8 rounded-card bg-night p-5 text-on-brand sm:p-10 lg:grid-cols-2 lg:gap-x-12 lg:gap-y-6 lg:p-12"
  aria-labelledby="service-system-title"
>
  <div class="grid content-start gap-6 lg:col-start-1 lg:row-start-1 lg:self-end">
    <div class="grid gap-3">
      <p class="flex flex-wrap items-baseline gap-x-2 text-sm font-bold text-on-brand-soft">
        <span class="font-latin font-semibold">{number}</span>
        <span aria-hidden="true">/</span>
        <span>{label}</span>
      </p>
      <h3 id="service-system-title" class="text-feature">{title}</h3>
      <p class="text-on-brand-soft">{body}</p>
    </div>
    <div class="grid gap-2">
      <p class="text-sm font-bold text-on-brand-soft">
        {examplesLabel}<span class="font-normal">（{examplesNote}）</span>
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          examples.map((example) => (
            <li class="rounded-full border border-night-line px-3 py-1 text-sm">{example}</li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="grid gap-3 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
    <p class="text-sm font-bold text-on-brand-soft">{stepsLabel}</p>
    <ol class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4" data-reveal>
      {
        steps.map((step, index) => (
          <li class="flex items-center gap-4 rounded-screen bg-night-raised p-3 sm:grid sm:content-start sm:gap-3 sm:p-4">
            <svg viewBox="0 0 120 72" class="block h-auto w-24 min-w-0 sm:w-full" aria-hidden="true" focusable="false" data-reveal-item>
              <rect width="120" height="72" rx="8" class="fill-surface" />
              {index === 0 && (
                <g>
                  <rect x="12" y="14" width="96" height="14" rx="4" class="fill-surface stroke-line-strong" stroke-width="1" />
                  <rect x="12" y="36" width="96" height="14" rx="4" class="fill-surface stroke-line-strong" stroke-width="1" />
                  <rect x="72" y="56" width="36" height="9" rx="4.5" class="fill-brand" />
                </g>
              )}
              {index === 1 && (
                <g>
                  <rect x="12" y="12" width="96" height="12" rx="4" class="fill-shape-soft" />
                  <rect x="12" y="30" width="96" height="12" rx="4" class="fill-shape-soft" />
                  <rect x="12" y="48" width="96" height="12" rx="4" class="fill-shape-soft" />
                  <rect x="80" y="15" width="22" height="6" rx="3" class="fill-shape-accent" />
                  <rect x="80" y="33" width="22" height="6" rx="3" class="fill-brand" />
                  <rect x="80" y="51" width="22" height="6" rx="3" class="fill-shape-accent" />
                </g>
              )}
              {index === 2 && (
                <g>
                  <rect x="12" y="12" width="28" height="22" rx="4" class="fill-shape-soft" />
                  <rect x="46" y="12" width="28" height="22" rx="4" class="fill-shape-soft" />
                  <rect x="80" y="12" width="28" height="22" rx="4" class="fill-brand" />
                  <rect x="12" y="42" width="96" height="6" rx="3" class="fill-shape-line" />
                  <rect x="12" y="54" width="64" height="6" rx="3" class="fill-shape-line" />
                </g>
              )}
            </svg>
            <p class="grid gap-0.5 font-bold">
              <span class="font-latin text-sm font-semibold text-on-brand-soft">{String(index + 1).padStart(2, '0')}</span>
              {step}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="lg:col-start-1 lg:row-start-2 lg:self-start">
    <Button href={contactHref} size="lg" variant="inverse" data-consult-field={cta.field}>
      {cta.label}
      <span aria-hidden="true" class="arrow-nudge arrow-nudge-right">→</span>
    </Button>
  </div>
</article>
