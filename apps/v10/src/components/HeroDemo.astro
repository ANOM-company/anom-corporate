---
/**
 * 冒頭の画面デモ（説明用）。図形が「AI・DX／Web／システム」の画面へ整う様子を、手動の切替で見せる。
 * - 図形は SVG の装飾（読み上げ対象外）。意味は各パネルの説明文（HTML）で伝える
 * - 切替は WAI のタブの設計パターン（src/scripts/hero-tabs.ts）。初期表示は先頭、自動では切り替えない
 * - JavaScript 無効時は切替ボタンを出さず、3つのパネルを縦に並べる（global.css の scripting: none）
 * - 3つのパネルは同じ位置に重ねて最も高いパネルの高さを確保し、切替で下の本文を動かさない
 */
import type { DemoView } from '../data/home';

type Props = {
  label: string;
  badge: string;
  views: DemoView[];
  /** サービス説明へのリンク先を作る関数（ページ内アンカー） */
  href: (anchor: string) => string;
};

const { label, badge, views, href } = Astro.props;
---

<div class="grid gap-4 rounded-demo bg-brand p-3 text-on-brand sm:p-5" data-demo-tabs>
  <div
    class="grid grid-cols-3 gap-1 rounded-full bg-brand-strong p-1 noscript:hidden"
    data-demo-tablist
    data-label={label}
  >
    {
      views.map((view, index) => (
        <button
          type="button"
          id={`demo-tab-${view.id}`}
          class="min-h-11 rounded-full px-2 font-bold text-on-brand transition-colors duration-(--duration-base) ease-standard hover:bg-shape data-selected:bg-surface data-selected:text-brand"
          data-demo-tab={`demo-panel-${view.id}`}
          data-selected={index === 0 ? '' : undefined}
        >
          {view.tab}
        </button>
      ))
    }
  </div>

  <div data-demo-panels>
    {
      views.map((view, index) => (
        <div
          id={`demo-panel-${view.id}`}
          class="grid content-start gap-4 rounded-control"
          data-demo-panel
          hidden={index !== 0}
        >
          <p class="hidden font-bold noscript:block">{view.title}</p>
          <svg
            viewBox="0 0 320 220"
            class="block h-auto w-full rounded-control"
            aria-hidden="true"
            focusable="false"
          >
            <rect width="320" height="220" rx="12" class="fill-shape-paper" />
            <rect width="320" height="22" rx="12" class="fill-muted" />
            <rect y="11" width="320" height="11" class="fill-muted" />
            <circle cx="16" cy="11" r="3" class="fill-line-strong" />
            <circle cx="28" cy="11" r="3" class="fill-line-strong" />
            <circle cx="40" cy="11" r="3" class="fill-line-strong" />
            {view.id === 'ai' && (
              <g>
                <rect x="20" y="48" width="70" height="22" rx="5" class="assemble fill-shape-soft" data-scatter="1" data-step="0" />
                <rect x="20" y="78" width="70" height="22" rx="5" class="assemble fill-shape-soft" data-scatter="2" data-step="1" />
                <rect x="20" y="108" width="70" height="22" rx="5" class="assemble fill-shape-soft" data-scatter="3" data-step="2" />
                <rect x="28" y="56" width="40" height="6" rx="3" class="assemble fill-shape-line" data-scatter="1" data-step="0" />
                <rect x="28" y="86" width="48" height="6" rx="3" class="assemble fill-shape-line" data-scatter="2" data-step="1" />
                <rect x="28" y="116" width="32" height="6" rx="3" class="assemble fill-shape-line" data-scatter="3" data-step="2" />
                <rect x="94" y="88" width="24" height="3" rx="1.5" class="assemble fill-shape-line" data-scatter="4" data-step="3" />
                <rect x="122" y="44" width="76" height="92" rx="8" class="assemble fill-brand" data-scatter="5" data-step="2" />
                <rect x="132" y="58" width="56" height="7" rx="3.5" class="assemble fill-shape-accent" data-scatter="6" data-step="3" />
                <rect x="132" y="74" width="44" height="7" rx="3.5" class="assemble fill-shape-accent" data-scatter="1" data-step="4" />
                <rect x="132" y="90" width="56" height="7" rx="3.5" class="assemble fill-shape-accent" data-scatter="4" data-step="4" />
                <rect x="132" y="106" width="36" height="7" rx="3.5" class="assemble fill-shape-accent" data-scatter="2" data-step="5" />
                <rect x="202" y="88" width="20" height="3" rx="1.5" class="assemble fill-shape-line" data-scatter="5" data-step="4" />
                <rect x="226" y="50" width="14" height="14" rx="3" class="assemble fill-shape-accent" data-scatter="6" data-step="4" />
                <rect x="246" y="53" width="54" height="8" rx="4" class="assemble fill-shape-soft" data-scatter="3" data-step="5" />
                <rect x="226" y="78" width="14" height="14" rx="3" class="assemble fill-shape-accent" data-scatter="2" data-step="5" />
                <rect x="246" y="81" width="44" height="8" rx="4" class="assemble fill-shape-soft" data-scatter="4" data-step="5" />
                <rect x="226" y="106" width="14" height="14" rx="3" class="assemble fill-shape-soft" data-scatter="1" data-step="6" />
                <rect x="246" y="109" width="50" height="8" rx="4" class="assemble fill-shape-soft" data-scatter="5" data-step="6" />
                <rect x="20" y="164" width="280" height="14" rx="7" class="assemble fill-shape-soft" data-scatter="3" data-step="3" />
                <rect x="20" y="164" width="188" height="14" rx="7" class="assemble fill-brand" data-scatter="6" data-step="6" />
              </g>
            )}
            {view.id === 'web' && (
              <g>
                <rect x="20" y="34" width="36" height="10" rx="3" class="assemble fill-brand" data-scatter="1" data-step="0" />
                <rect x="196" y="37" width="24" height="5" rx="2.5" class="assemble fill-shape-line" data-scatter="2" data-step="1" />
                <rect x="228" y="37" width="24" height="5" rx="2.5" class="assemble fill-shape-line" data-scatter="4" data-step="1" />
                <rect x="260" y="37" width="40" height="5" rx="2.5" class="assemble fill-shape-line" data-scatter="6" data-step="2" />
                <rect x="20" y="64" width="124" height="14" rx="4" class="assemble fill-brand" data-scatter="3" data-step="1" />
                <rect x="20" y="84" width="92" height="14" rx="4" class="assemble fill-brand" data-scatter="5" data-step="2" />
                <rect x="20" y="110" width="124" height="6" rx="3" class="assemble fill-shape-line" data-scatter="1" data-step="3" />
                <rect x="20" y="122" width="108" height="6" rx="3" class="assemble fill-shape-line" data-scatter="2" data-step="3" />
                <rect x="20" y="140" width="64" height="18" rx="9" class="assemble fill-shape-accent" data-scatter="4" data-step="4" />
                <rect x="168" y="60" width="132" height="98" rx="8" class="assemble fill-shape-soft" data-scatter="6" data-step="2" />
                <circle cx="196" cy="86" r="10" class="assemble fill-shape-accent" data-scatter="3" data-step="4" />
                <polygon points="176,150 222,104 250,132 266,118 292,150" class="assemble fill-shape-line" data-scatter="5" data-step="5" />
                <rect x="20" y="174" width="84" height="30" rx="6" class="assemble fill-shape-soft" data-scatter="1" data-step="5" />
                <rect x="118" y="174" width="84" height="30" rx="6" class="assemble fill-shape-soft" data-scatter="3" data-step="6" />
                <rect x="216" y="174" width="84" height="30" rx="6" class="assemble fill-shape-soft" data-scatter="5" data-step="6" />
              </g>
            )}
            {view.id === 'system' && (
              <g>
                <rect x="10" y="32" width="56" height="178" rx="8" class="assemble fill-brand" data-scatter="1" data-step="0" />
                <rect x="20" y="48" width="36" height="6" rx="3" class="assemble fill-shape-accent" data-scatter="2" data-step="1" />
                <rect x="20" y="64" width="30" height="6" rx="3" class="assemble fill-shape-line" data-scatter="3" data-step="1" />
                <rect x="20" y="80" width="36" height="6" rx="3" class="assemble fill-shape-line" data-scatter="4" data-step="2" />
                <rect x="20" y="96" width="26" height="6" rx="3" class="assemble fill-shape-line" data-scatter="5" data-step="2" />
                <rect x="78" y="34" width="84" height="20" rx="5" class="assemble fill-surface stroke-line-strong" stroke-width="1" data-scatter="6" data-step="1" />
                <rect x="170" y="34" width="84" height="20" rx="5" class="assemble fill-surface stroke-line-strong" stroke-width="1" data-scatter="2" data-step="2" />
                <rect x="262" y="34" width="46" height="20" rx="5" class="assemble fill-brand" data-scatter="4" data-step="3" />
                <rect x="78" y="66" width="230" height="22" rx="5" class="assemble fill-surface stroke-line" stroke-width="1" data-scatter="1" data-step="3" />
                <rect x="78" y="94" width="230" height="22" rx="5" class="assemble fill-surface stroke-line" stroke-width="1" data-scatter="3" data-step="3" />
                <rect x="78" y="122" width="230" height="22" rx="5" class="assemble fill-surface stroke-line" stroke-width="1" data-scatter="5" data-step="4" />
                <rect x="78" y="150" width="230" height="22" rx="5" class="assemble fill-surface stroke-line" stroke-width="1" data-scatter="6" data-step="4" />
                <rect x="88" y="74" width="96" height="6" rx="3" class="assemble fill-shape-line" data-scatter="1" data-step="4" />
                <rect x="88" y="102" width="72" height="6" rx="3" class="assemble fill-shape-line" data-scatter="3" data-step="4" />
                <rect x="88" y="130" width="88" height="6" rx="3" class="assemble fill-shape-line" data-scatter="5" data-step="5" />
                <rect x="88" y="158" width="64" height="6" rx="3" class="assemble fill-shape-line" data-scatter="6" data-step="5" />
                <rect x="262" y="72" width="36" height="10" rx="5" class="assemble fill-shape-accent" data-scatter="2" data-step="5" />
                <rect x="262" y="100" width="36" height="10" rx="5" class="assemble fill-shape-soft" data-scatter="4" data-step="5" />
                <rect x="262" y="128" width="36" height="10" rx="5" class="assemble fill-brand" data-scatter="1" data-step="6" />
                <rect x="262" y="156" width="36" height="10" rx="5" class="assemble fill-shape-accent" data-scatter="3" data-step="6" />
                <rect x="78" y="182" width="70" height="26" rx="6" class="assemble fill-shape-soft" data-scatter="2" data-step="6" />
                <rect x="158" y="182" width="70" height="26" rx="6" class="assemble fill-shape-soft" data-scatter="4" data-step="6" />
                <rect x="238" y="182" width="70" height="26" rx="6" class="assemble fill-shape-soft" data-scatter="6" data-step="6" />
              </g>
            )}
          </svg>
          <div class="grid gap-3 px-1 pb-1">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="inline-flex items-center rounded-full border border-on-brand-soft px-2.5 text-sm font-bold text-on-brand">
                {badge}
              </span>
              <span class="text-on-brand-soft">{view.caption}</span>
            </p>
            <p>
              <a
                href={href(view.link.anchor)}
                class="inline-flex min-h-11 items-center gap-2 rounded-control font-bold text-on-brand underline decoration-on-brand-soft underline-offset-4 hover:text-on-brand hover:decoration-on-brand"
              >
                {view.link.label}
                <span aria-hidden="true">→</span>
              </a>
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import '../scripts/hero-tabs';
</script>
