---
/**
 * 主力サービスの1枠（AI・DX支援／Web制作・運用保守）。2枠は同じ幅・同じ見出しの階層・同じ情報量で並べる。
 * - 読み順: 番号と分野名 → 見出し → 短い説明 → 小さな説明図 → 対象 → 相談例 → 相談ボタン
 * - 相談ボタンは #contact への通常のリンク。JavaScript 有効時だけ相談分野を引き継ぐ（data-consult-field）
 * - 図は本文と同じ意味を繰り返す装飾（読み上げ対象外）。画面に入ったとき1回だけ少し現れる（data-reveal）
 */
import Button from './Button.astro';
import type { ServiceContent } from '../data/home';

type Props = {
  item: ServiceContent;
  audienceLabel: string;
  examplesLabel: string;
  examplesNote: string;
  contactHref: string;
};

const { item, audienceLabel, examplesLabel, examplesNote, contactHref } = Astro.props;
const titleId = `${item.id}-title`;
---

<article id={item.id} class="flex flex-col gap-6 rounded-card border border-line bg-surface p-5 sm:p-8 lg:p-10" aria-labelledby={titleId}>
  <div class="grid gap-3">
    <p class="flex flex-wrap items-baseline gap-x-2 text-sm font-bold text-brand">
      <span class="font-latin font-semibold">{item.number}</span>
      <span aria-hidden="true" class="text-ink-soft">/</span>
      <span>{item.label}</span>
    </p>
    <h3 id={titleId} class="text-3xl">{item.title}</h3>
    <p class="text-ink-soft">{item.body}</p>
  </div>
  <div data-reveal>
    <svg viewBox="0 0 240 96" class="block h-auto w-full max-w-96" aria-hidden="true" focusable="false" data-reveal-item>
      <rect width="240" height="96" rx="12" class="fill-muted" />
      {
        item.figure === 'ai' ? (
          <g>
            <rect x="18" y="18" width="40" height="14" rx="4" class="fill-shape-soft" transform="rotate(-8 38 25)" />
            <rect x="30" y="42" width="34" height="14" rx="4" class="fill-shape-soft" transform="rotate(6 47 49)" />
            <rect x="14" y="64" width="44" height="14" rx="4" class="fill-shape-soft" transform="rotate(-4 36 71)" />
            <rect x="80" y="47" width="22" height="2" rx="1" class="fill-shape-line" />
            <rect x="112" y="20" width="56" height="56" rx="8" class="fill-night" />
            <rect x="122" y="32" width="36" height="5" rx="2.5" class="fill-shape-accent" />
            <rect x="122" y="45" width="28" height="5" rx="2.5" class="fill-shape-accent" />
            <rect x="122" y="58" width="36" height="5" rx="2.5" class="fill-shape-accent" />
            <rect x="176" y="47" width="14" height="2" rx="1" class="fill-shape-line" />
            <rect x="196" y="24" width="28" height="12" rx="4" class="fill-brand" />
            <rect x="196" y="42" width="28" height="12" rx="4" class="fill-brand" />
            <rect x="196" y="60" width="28" height="12" rx="4" class="fill-shape-soft" />
          </g>
        ) : (
          <g>
            <rect x="16" y="14" width="208" height="68" rx="8" class="fill-surface stroke-line" stroke-width="1" />
            <rect x="16" y="14" width="208" height="12" rx="6" class="fill-shape-soft" />
            <rect x="28" y="36" width="72" height="9" rx="3" class="fill-ink" />
            <rect x="28" y="51" width="88" height="4" rx="2" class="fill-shape-line" />
            <rect x="28" y="60" width="64" height="4" rx="2" class="fill-shape-line" />
            <rect x="28" y="69" width="34" height="8" rx="4" class="fill-brand" />
            <rect x="132" y="34" width="80" height="40" rx="6" class="fill-shape-soft" />
            <circle cx="150" cy="47" r="6" class="fill-shape-accent" />
            <polygon points="138,70 164,48 180,62 188,56 206,70" class="fill-shape-line" />
          </g>
        )
      }
    </svg>
  </div>
  <dl class="grid gap-1 border-t border-line pt-4">
    <dt class="text-sm font-bold text-ink-soft">{audienceLabel}</dt>
    <dd>{item.audience}</dd>
  </dl>
  <div class="grid gap-2">
    <p class="text-sm font-bold text-ink-soft">
      {examplesLabel}<span class="font-normal">（{examplesNote}）</span>
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        item.examples.map((example) => (
          <li class="rounded-full border border-line bg-canvas px-3 py-1 text-sm">{example}</li>
        ))
      }
    </ul>
  </div>
  <div class="mt-auto pt-2">
    <Button href={contactHref} size="lg" variant="secondary" data-consult-field={item.cta.field}>
      {item.cta.label}
      <span aria-hidden="true" class="arrow-nudge arrow-nudge-right">→</span>
    </Button>
  </div>
</article>
