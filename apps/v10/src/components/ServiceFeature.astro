---
/**
 * 主力サービスの1枠（AI・DX支援／Web制作・運用保守）。2枠は同じ幅・同じ見出しの階層・同じ情報量で並べる。
 * - 読み順: 番号と分野名 → 見出し → 短い説明 → 説明図 → 対象 → 相談例 → 相談ボタン
 * - 相談ボタンは #contact への通常のリンク。JavaScript 有効時だけ相談分野を引き継ぐ（data-consult-field）
 * - 図は本文と同じ意味を繰り返す装飾（読み上げ対象外）。枠の幅いっぱいに置き、面の重なりで奥行きを出す。
 *   画面に入ったとき1回だけ、層の順に少し現れる（data-reveal）
 */
import Button from './Button.astro';
import type { ServiceContent } from '../data/home';

type Props = {
  item: ServiceContent;
  audienceLabel: string;
  examplesLabel: string;
  examplesNote: string;
  contactHref: string;
};

const { item, audienceLabel, examplesLabel, examplesNote, contactHref } = Astro.props;
const titleId = `${item.id}-title`;
---

<article id={item.id} class="flex flex-col gap-6 rounded-card border border-line bg-surface p-5 sm:p-8 lg:p-10" aria-labelledby={titleId}>
  <div class="grid gap-3">
    <p class="flex flex-wrap items-baseline gap-x-2 text-sm font-bold text-brand">
      <span class="font-latin font-semibold">{item.number}</span>
      <span aria-hidden="true" class="text-ink-soft">/</span>
      <span>{item.label}</span>
    </p>
    <h3 id={titleId} class="text-feature">{item.title}</h3>
    <p class="text-ink-soft">{item.body}</p>
  </div>
  <div data-reveal>
    <svg viewBox="0 0 480 220" class="block h-auto w-full" aria-hidden="true" focusable="false">
      <rect width="480" height="220" rx="16" class="fill-muted" />
      {
        item.figure === 'ai' ? (
          <>
            {/* 散らばった情報 */}
            <g data-reveal-item>
              <g transform="rotate(-8 74 51)">
                <rect x="28" y="36" width="92" height="30" rx="8" class="fill-surface stroke-line" />
                <rect x="40" y="48" width="48" height="6" rx="3" class="fill-shape-line" />
              </g>
              <g transform="rotate(6 94 99)">
                <rect x="52" y="84" width="84" height="30" rx="8" class="fill-surface stroke-line" />
                <rect x="64" y="96" width="40" height="6" rx="3" class="fill-shape-line" />
              </g>
              <g transform="rotate(-4 74 147)">
                <rect x="24" y="132" width="100" height="30" rx="8" class="fill-surface stroke-line" />
                <rect x="36" y="144" width="56" height="6" rx="3" class="fill-shape-line" />
              </g>
              <rect x="92" y="172" width="56" height="20" rx="7" class="fill-shape-soft" transform="rotate(9 120 182)" />
            </g>
            {/* 整理する画面（奥の面と重ねて奥行きを出す） */}
            <g data-reveal-item>
              <rect x="152" y="109" width="26" height="2" rx="1" class="fill-shape-line" />
              <circle cx="183" cy="110" r="4" class="fill-brand" />
              <rect x="204" y="24" width="140" height="160" rx="14" class="fill-shape-soft" />
              <rect x="192" y="36" width="140" height="160" rx="14" class="fill-night" />
              <circle cx="210" cy="54" r="3" class="fill-night-line" />
              <circle cx="220" cy="54" r="3" class="fill-night-line" />
              <circle cx="230" cy="54" r="3" class="fill-shape-accent" />
              <rect x="208" y="72" width="16" height="16" rx="5" class="fill-shape-accent" />
              <rect x="234" y="77" width="82" height="6" rx="3" class="fill-shape-line" />
              <rect x="208" y="100" width="16" height="16" rx="5" class="fill-shape-accent" />
              <rect x="234" y="105" width="64" height="6" rx="3" class="fill-shape-line" />
              <rect x="208" y="128" width="16" height="16" rx="5" class="fill-shape-accent" />
              <rect x="234" y="133" width="76" height="6" rx="3" class="fill-shape-line" />
              <rect x="208" y="156" width="16" height="16" rx="5" class="fill-shape" />
              <rect x="234" y="161" width="52" height="6" rx="3" class="fill-shape" />
            </g>
            {/* 仕事に使える形 */}
            <g data-reveal-item>
              <rect x="350" y="109" width="16" height="2" rx="1" class="fill-shape-line" />
              <rect x="372" y="50" width="84" height="32" rx="9" class="fill-brand" />
              <rect x="384" y="63" width="44" height="6" rx="3" class="fill-shape-accent" />
              <rect x="372" y="94" width="84" height="32" rx="9" class="fill-brand" />
              <rect x="384" y="107" width="52" height="6" rx="3" class="fill-shape-accent" />
              <rect x="372" y="138" width="84" height="32" rx="9" class="fill-surface stroke-line" />
              <rect x="384" y="151" width="36" height="6" rx="3" class="fill-shape-line" />
            </g>
          </>
        ) : (
          <g transform="translate(6 2)">
            {/* 奥のページ（重なりによる奥行き） */}
            <g data-reveal-item>
              <rect x="92" y="20" width="312" height="150" rx="12" class="fill-shape-soft" />
            </g>
            {/* パソコンの画面: 見出し・文章・導線・画像 */}
            <g data-reveal-item>
              <rect x="32" y="38" width="316" height="164" rx="12" class="fill-surface" />
              <rect x="32" y="38" width="316" height="24" rx="12" class="fill-shape-soft" />
              <rect x="32" y="50" width="316" height="12" class="fill-shape-soft" />
              <circle cx="48" cy="50" r="3" class="fill-shape-line" />
              <circle cx="59" cy="50" r="3" class="fill-shape-line" />
              <circle cx="70" cy="50" r="3" class="fill-shape-line" />
              <rect x="52" y="82" width="120" height="14" rx="4" class="fill-ink" />
              <rect x="52" y="104" width="88" height="14" rx="4" class="fill-ink" />
              <rect x="52" y="132" width="124" height="6" rx="3" class="fill-shape-line" />
              <rect x="52" y="146" width="100" height="6" rx="3" class="fill-shape-line" />
              <rect x="52" y="166" width="64" height="20" rx="10" class="fill-brand" />
              <rect x="200" y="80" width="130" height="104" rx="10" class="fill-shape-soft" />
              <circle cx="228" cy="106" r="10" class="fill-shape-accent" />
              <polygon points="210,174 252,132 280,158 294,146 320,174" class="fill-shape-line" />
              <rect x="32" y="38" width="316" height="164" rx="12" class="fill-none stroke-line" />
            </g>
            {/* スマホの画面（同じ内容が小さな画面にも届く） */}
            <g data-reveal-item>
              <rect x="340" y="62" width="96" height="146" rx="16" class="fill-night" />
              <rect x="347" y="74" width="82" height="122" rx="10" class="fill-surface" />
              <rect x="356" y="86" width="48" height="8" rx="3" class="fill-ink" />
              <rect x="356" y="102" width="64" height="44" rx="6" class="fill-shape-soft" />
              <rect x="356" y="154" width="58" height="5" rx="2.5" class="fill-shape-line" />
              <rect x="356" y="164" width="44" height="5" rx="2.5" class="fill-shape-line" />
              <rect x="356" y="176" width="40" height="12" rx="6" class="fill-brand" />
            </g>
          </g>
        )
      }
    </svg>
  </div>
  <dl class="grid gap-1 border-t border-line pt-4">
    <dt class="text-sm font-bold text-ink-soft">{audienceLabel}</dt>
    <dd>{item.audience}</dd>
  </dl>
  <div class="grid gap-2">
    <p class="text-sm font-bold text-ink-soft">
      {examplesLabel}<span class="font-normal">（{examplesNote}）</span>
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        item.examples.map((example) => (
          <li class="rounded-full border border-line bg-canvas px-3 py-1 text-sm">{example}</li>
        ))
      }
    </ul>
  </div>
  <div class="mt-auto pt-2">
    <Button href={contactHref} size="lg" variant="secondary" data-consult-field={item.cta.field}>
      {item.cta.label}
      <span aria-hidden="true" class="arrow-nudge arrow-nudge-right">→</span>
    </Button>
  </div>
</article>
