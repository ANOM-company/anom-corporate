---
/**
 * ラベル付きの入力欄。ラベル・補足・エラー文を入力欄と結び付ける。
 * - error を渡すとエラー状態（aria-invalid と赤い枠・エラー文）で表示する
 * - multiline で複数行（textarea）になる
 * - required で「必須」、optional で「任意」の印をラベルに付ける（色だけでなく文字で示す）
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  id: string;
  label: string;
  name?: string;
  type?: 'text' | 'email' | 'tel' | 'url';
  hint?: string;
  error?: string;
  required?: boolean;
  multiline?: boolean;
  optional?: boolean;
  maxlength?: number;
  rows?: number;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
};

const {
  id,
  label,
  name = id,
  type = 'text',
  hint,
  error,
  required = false,
  multiline = false,
  optional = false,
  maxlength,
  rows = 4,
  autocomplete,
} = Astro.props;

const hintId = `${id}-hint`;
const errorId = `${id}-error`;
// 補足とエラー文の両方を読み上げ対象にする（エラー文は空でも要素を置き、JSで中身を入れる）
const describedBy = [hint ? hintId : null, errorId].filter(Boolean).join(' ');
const field =
  'block w-full rounded-control border bg-surface px-3 py-2 text-base text-ink border-line-strong aria-invalid:border-danger aria-invalid:border-2';
---

<div class="grid gap-1.5" data-field>
  <label for={id} class="font-bold">
    {label}
    {required && <span class="ms-2 rounded-sm bg-brand px-1.5 py-0.5 text-sm font-bold text-on-brand">必須</span>}
    {optional && <span class="ms-2 rounded-sm border border-line-strong px-1.5 text-sm font-bold text-ink-soft">任意</span>}
  </label>
  {
    hint && (
      <p id={hintId} class="text-sm text-ink-soft">
        {hint}
      </p>
    )
  }
  {
    multiline ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        maxlength={maxlength}
        class={field}
        required={required}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        class={field}
        required={required}
        maxlength={maxlength}
        autocomplete={autocomplete}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
      />
    )
  }
  <p id={errorId} class="text-sm font-bold text-danger empty:hidden" data-error>{error}</p>
</div>
