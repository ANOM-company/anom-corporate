---
/**
 * 学びの計画（#learning）。提供中サービスより小さな面と短い説明で扱う。
 * - 状態「構想中」は色だけでなく文字で示す。開催日・料金・申込みは置かない
 */
import SectionHeading from './SectionHeading.astro';

type Props = {
  eyebrow: string;
  title: string;
  items: { title: string; body: string; status: string }[];
  note: string;
  contactNote: string;
};

const { eyebrow, title, items, note, contactNote } = Astro.props;
---

<section id="learning" class="bg-muted py-(--spacing-section)" aria-labelledby="learning-title">
  <div class="container-content grid gap-8">
    <SectionHeading id="learning-title" eyebrow={eyebrow} title={title} />
    <ul class="grid max-w-4xl gap-4 md:grid-cols-2">
      {
        items.map((item) => (
          <li class="grid content-start gap-3 rounded-card border border-line bg-surface p-5">
            <p>
              <span class="inline-flex items-center rounded-full border border-line-strong px-2.5 text-sm font-bold">
                {item.status}
              </span>
            </p>
            <h3 class="text-lg">{item.title}</h3>
            <p class="text-ink-soft">{item.body}</p>
          </li>
        ))
      }
    </ul>
    <div class="grid gap-1 text-sm text-ink-soft">
      <p>{note}</p>
      <p>{contactNote}</p>
    </div>
  </div>
</section>
