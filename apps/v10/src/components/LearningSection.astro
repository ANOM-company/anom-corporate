---
/**
 * 学びの計画（#learning）。提供中サービスより小さな面と短い説明で扱う。
 * - 状態「構想中」は色だけでなく文字で示す。開催日・料金・申込みは置かない
 * - PC（1024px以上）は 見出し5：内容7。文字サイズの設定を大きくして左右に分ける幅が足りないときは縦に並べる
 */
import SectionHeading from './SectionHeading.astro';

type Props = {
  eyebrow: string;
  title: string;
  items: { title: string; body: string; status: string }[];
  note: string;
  contactNote: string;
};

const { eyebrow, title, items, note, contactNote } = Astro.props;
---

<section id="learning" class="@container bg-muted py-(--spacing-section)" aria-labelledby="learning-title">
  <div class="container-content grid grid-cols-1 gap-8 lg:@split:grid-cols-12 lg:@split:gap-12">
    <div class="lg:@split:col-span-5">
      <SectionHeading id="learning-title" eyebrow={eyebrow} title={title} />
    </div>
    <div class="grid grid-cols-1 content-start gap-6 lg:@split:col-span-7">
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:max-xl:grid-cols-1">
        {
          items.map((item) => (
            <li class="grid content-start gap-3 rounded-card border border-line bg-surface p-5 sm:p-6">
              <p>
                <span class="inline-flex items-center rounded-full border border-line-strong px-2.5 text-sm font-bold">
                  {item.status}
                </span>
              </p>
              <h3 class="text-lg">{item.title}</h3>
              <p class="text-ink-soft">{item.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="grid gap-1 text-sm text-ink-soft">
        <p>{note}</p>
        <p>{contactNote}</p>
      </div>
    </div>
  </div>
</section>
