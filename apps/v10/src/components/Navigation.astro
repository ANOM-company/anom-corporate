---
/**
 * サイトのヘッダーとナビゲーション。
 * - PC幅: リンクを横並びで常に表示
 * - スマホ幅: <details> の開閉メニュー（JavaScript無効でも開閉できる）
 * - JavaScript有効時は Esc で閉じてメニューボタンへフォーカスを戻す（src/scripts/navigation.ts）
 */
export type NavItem = { label: string; href: string };

type Props = {
  items: NavItem[];
  siteName: string;
};

const { items, siteName } = Astro.props;
const current = Astro.url.pathname;
---

<header class="relative border-b border-line bg-surface">
  <div class="container-content flex min-h-16 flex-wrap items-center justify-between gap-x-6 py-2">
    <a href="/" class="py-2 text-lg font-bold text-ink no-underline">{siteName}</a>
    <nav aria-label="メイン" class="contents md:block">
      <ul class="hidden items-center gap-1 md:flex">
        {
          items.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center rounded-control px-3 text-ink no-underline hover:bg-muted aria-[current=page]:underline"
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="group md:hidden" data-nav-menu>
        <summary
          class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-control border border-line-strong px-4 font-bold [&::-webkit-details-marker]:hidden"
        >
          <span aria-hidden="true" class="block w-4 border-t-2 border-current shadow-[0_5px_0_currentColor,0_-5px_0_currentColor]"
          ></span>
          メニュー
        </summary>
        <ul class="absolute inset-x-0 z-10 mt-2 grid gap-1 border-b border-line bg-surface px-4 py-3">
          {
            items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="flex min-h-11 items-center rounded-control px-3 text-ink no-underline hover:bg-muted aria-[current=page]:underline"
                  aria-current={current === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  import '../scripts/navigation';
</script>
